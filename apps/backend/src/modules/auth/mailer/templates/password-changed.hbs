<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>{{appName}} – Password Changed</title>
    <style>
      body { font-family: Arial, Helvetica, sans-serif; color: #111; line-height: 1.6; }
      .card { max-width: 560px; margin: 0 auto; border: 1px solid #e5e7eb; border-radius: 10px; padding: 24px; }
      .muted { color: #6b7280; font-size: 12px; }
    </style>
  </head>
  <body>
    <div class="card">
      <h2>Your password was changed</h2>
      <p>Hi {{username}},</p>
      <p>This is a confirmation that the password for your {{appName}} account ({{email}}) was changed on <strong>{{changedAtHuman}}</strong>.</p>
      <p class="muted">Change details: {{ip}} · {{ua}}</p>
      <p>If this wasn’t you, please reset your password immediately or contact our support.</p>
      <p>— The {{appName}} Team</p>
    </div>
  </body>
</html>
